NEXT_PUBLIC_APP_NAME="GMAT Study Agent"

# Local development can leave this empty. Production should set a lightweight access password.
APP_ACCESS_PASSWORD=""

# Supabase placeholders for later stages. Do not expose service role keys in browser code.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="gmat-screenshots"
MAX_UPLOAD_MB="10"

# DeepSeek/OpenAI-compatible LLM placeholders. LLM_MODEL must be read from env when AI is added.
LLM_PROVIDER="deepseek"
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL=""

# OCR is intentionally manual by default for MVP.
OCR_PROVIDER="manual"
OCR_API_BASE_URL=""
OCR_API_KEY=""
